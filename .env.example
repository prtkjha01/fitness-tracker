# Copy to .env.local and fill in. Only EXPO_PUBLIC_* values are bundled into the app.
# Local dev: values printed by `bunx supabase start` (API URL + Publishable key).
# Never put the secret / service_role key here.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
